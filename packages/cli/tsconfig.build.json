{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "rootDir": "..",
    "outDir": "dist",
    "noEmit": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": false,
    "sourceMap": false,
    "paths": {}
  },
  "include": ["src/**/*.ts", "../workflows/src/**/*.ts", "../runner/src/**/*.ts"],
  "exclude": ["dist", "../workflows/dist", "../runner/dist", "node_modules"]
}
