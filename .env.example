# Public operator configuration. Builds and local setup need no account IDs.
# Copy only settings you intend to override into your shell or an ignored .env.
GITKNOT_MODE=development
GITKNOT_DEVELOPMENT_CELL_ID=cell-001
GITKNOT_DEVELOPMENT_EXECUTION_CELL_ID=exec-001
GITKNOT_DEVELOPMENT_SHARDS=1

# Each mode is a complete, separately named topology. Account IDs are resolved
# explicitly by an operator, never inferred from a login during setup/build.
# GITKNOT_STAGING_TRUST_ACCOUNT_ID=
# GITKNOT_STAGING_EXECUTION_ACCOUNT_ID=
# GITKNOT_STAGING_CELL_ID=cell-001
# GITKNOT_STAGING_EXECUTION_CELL_ID=exec-001
# GITKNOT_STAGING_SHARDS=1
# GITKNOT_STAGING_JURISDICTION=eu
# GITKNOT_PRODUCTION_TRUST_ACCOUNT_ID=
# GITKNOT_PRODUCTION_EXECUTION_ACCOUNT_ID=
# GITKNOT_PRODUCTION_CELL_ID=cell-001
# GITKNOT_PRODUCTION_EXECUTION_CELL_ID=exec-001
# GITKNOT_PRODUCTION_SHARDS=1
# GITKNOT_PRODUCTION_DIRECTORY_CELL_ID=cell-001
# GITKNOT_PRODUCTION_IDENTITY_CELL_ID=cell-001
# The identity home uses its core-001 database. Config derives both runtime
# IDENTITY_CELL_ID and IDENTITY_SHARD_ID from that same physical storage target.
# GITKNOT_PRODUCTION_INGRESS_CELL_ID=cell-001
# GITKNOT_PRODUCTION_PEERS_FILE=/private/path/peer-cells.json
# GITKNOT_PRODUCTION_RECOVERY_MODE=true
# GITKNOT_PRODUCTION_EXECUTION_PAUSED=true
# GITKNOT_PRODUCTION_JURISDICTION=eu
# Select existing funded catalog slices; these bindings do not allocate capacity.
# GITKNOT_PRODUCTION_BILLING_PLATFORM_SLICE_ID=
# GITKNOT_PRODUCTION_BILLING_GIT_STORAGE_SLICE_ID=
# GITKNOT_PRODUCTION_BILLING_ESSENTIAL_SLICE_ID=

# Use digest-pinned image references and real measured profile evidence for a
# release. With no image reference, cf builds the native Dockerfile locally.
# GITKNOT_PRODUCTION_GIT_IMAGE=registry.cloudflare.com/ACCOUNT/gitknot-native@sha256:DIGEST
# GITKNOT_PRODUCTION_SANDBOX_IMAGE=registry.cloudflare.com/ACCOUNT/gitknot-sandbox@sha256:DIGEST
# GITKNOT_PRODUCTION_EGRESS_IMAGE=registry.cloudflare.com/ACCOUNT/gitknot-egress@sha256:DIGEST
# GITKNOT_PRODUCTION_HOSTED_PROFILES_FILE=/private/path/hosted-profiles.json
# Optional remote hosted account; file follows infra/hosted-executor.example.json.
# Its callback_origin must equal the selected API origin. Its HTTPS origin must
# have an active DNS zone in the execution account before a Custom Domain rollout.
# Infra pins that same callback_origin as HOSTED_CALLBACK_ORIGIN on hosted.
# GITKNOT_PRODUCTION_HOSTED_EXECUTOR_FILE=/private/path/hosted-executor.json
# Keep old trusted control/callback bindings while their dispatches are live.
# GITKNOT_PRODUCTION_HOSTED_PREVIOUS_KEY_BINDINGS=HOSTED_CONTROL_KEY_202609,HOSTED_CALLBACK_KEY_V1
# GITKNOT_PRODUCTION_KEK_CURRENT_ID=primary-v1
# GITKNOT_PRODUCTION_FEDERATION_TRUSTED_ORIGINS_FILE=/private/path/approved-idp-origins.json

# An alternate ignored state file must still match mode, cell and execution cell.
# GITKNOT_STATE_FILE=/private/path/state.json

# Operator secrets are supplied by a password manager / CI secret store, not
# this file. Supported names: GITKNOT_PRODUCTION_TRUST_API_TOKEN,
# GITKNOT_PRODUCTION_EXECUTION_API_TOKEN, and staging equivalents.
# Product operations use GITKNOT_OPERATOR_TOKEN. Capacity tests use
# GITKNOT_LOAD_TOKEN. Neither is a Cloudflare account token.
# D1/R2 recovery can use a separately controlled GITKNOT_PRODUCTION_BACKUP_API_TOKEN.
# Every API requires the IDENTITY_KEYS_JSON secret. Use an identical version-to-key
# map across all API cells in one mode, with separate staging/production material.
# Distribute new versions everywhere before switching current; preserve old keys
# for live, unresolved or restorable requests and all remaining identity references.
# Never reuse a key ID for different bytes. See docs/operations.md for rotation.
# Remote mode requires the selected control key plus callback_key_binding from
# HOSTED_EXECUTOR_FILE on API/background/execution. The callback name defaults
# to HOSTED_CALLBACK_KEY when absent. Retain that unversioned binding in the
# previous-key list when switching existing dispatches to a versioned name.
# Hosted receives only HOSTED_CONTROL_KEY, never callback masters/internal/vault keys.
